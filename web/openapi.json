  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "`{ \"error\": { \"kind\", \"message\" } }`",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "`bad_request`, `not_found`, `conflict`, `invalid` or `internal`."
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ExecuteBody": {
        "type": "object",
        "properties": {
          "collection": {
            "type": [
              "string",
              "null"
            ],
            "description": "Or a collection request: collection id and request key."
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "request": {
            "type": [
              "object",
              "null"
            ],
            "description": "A complete request (the core JSON model)."
          },
          "vars": {
            "type": "object",
            "description": "Variables for this execution (highest precedence).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "HistoryList": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
