          "id",
          "created_at",
          "kind",
          "target_key",
          "name",
          "passed"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "target_key": {
            "type": "string"
          }
        }
      }
    }
