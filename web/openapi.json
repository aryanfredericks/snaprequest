              "$ref": "#/components/schemas/HistorySummary"
            }
          }
        }
      },
      "HistorySummary": {
        "type": "object",
        "description": "A row of the history list (without the large JSON columns).",
        "required": [
          "id",
          "created_at",
          "method",
          "url"
        ],
        "properties": {
          "collection": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix milliseconds."
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "method": {
            "type": "string"
          },
          "request_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "url": {
            "type": "string"
          }
        }
      },
      "JsonDocument": {
        "type": "object",
        "description": "A JSON document; its shape is described in `docs/SERVER.md`."
      },
      "NewCollection": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "RunBody": {
        "type": "object",
        "required": [
          "collection"
        ],
        "properties": {
          "bail": {
            "type": "boolean"
          },
          "collection": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "One iteration per row."
          },
          "delay_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "iterations": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "parallel": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "description": "A flow or folder key; absent runs every request of the collection."
          },
          "vars": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "RunList": {
        "type": "object",
        "required": [
          "runs"
        ],
        "properties": {
